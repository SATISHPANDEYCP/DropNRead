<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Delete Your Account</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>
    <header class="header">
        <h1>Delete Your Drop<span style="color: #6200ea;">N</span>Read Account</h1>
    </header>
    <main class="form-container">
        <h3 style="color: #6200ea; font-size: 1.5rem;">Please Confirm Your Details</h3>
        <form action="/deleteUser?_method=DELETE" method="POST" class="chat-form">

            <input id="name" type="text" name="name" placeholder="Enter your full name(Case Senstive)" required>
            <input id="username" type="text" name="username" placeholder="Enter your username(Case Senstive)" required>
            <input id="email" type="email" name="email" placeholder="Enter your email(Case Senstive)" required>
            <input id="password" type="password" name="password" placeholder="Enter your password" required>
            <button type="submit" class="button-style del-btn">Delete Your Account</button>
        </form>
    </main>
    <footer class="footer">
        <p>&copy; 2025 Message Drop | Designed with ❤️ by Satish Pandey.</p>
    </footer>
</body>

</html>