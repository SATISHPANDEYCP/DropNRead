<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DropNRead - Login</title>
    <link rel="stylesheet" href="/login.css">
    <script src="https://cdn.jsdelivr.net/npm/typed.js@2.0.12"></script> <!-- Include the Typed.js library -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r134/three.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/vanta@latest/dist/vanta.fog.min.js"></script>
</head>

<body>

    <header class="header">
        <img src="/favicon.png">
        <h1>Drop<span style="color: #FF4500;">N</span>Read</h1>
    </header>
    <main class="form-container">
        <div class="intro">
            <h3>Welcome to Drop<span style="color: #333;">N</span>Read!</h3>
            <p id="typed-text"></p>
        </div>
        <div class="login-form-container">
            <h3>Login</h3>
            <form action="/login" method="POST" class="chat-form">
                <input type="email" name="email" placeholder="Email" required>
                <input type="password" name="password" placeholder="Password (Case Senstive)" required>
                <button type="submit">Login</button>
                <p>New user? <a href="/register">register here</a></p>
                <p><a href="/reset-password">Forgot password?</a></p>
            </form>
        </div>
    </main>
    <footer class="footer">
        <p>&copy; 2025 Message Drop | Designed with ❤️ by Satish Pandey.</p>
    </footer>
    <script>
        var options = {
            strings: [
                "Start meaningful conversations today with DropNRead! Sign up, log in, and leave personalized messages for friends, family, or colleagues. Simply enter their name, username, or email, and drop a message—it’s secure, private, and easy to use!",
                "DropNRead makes communication effortless and confidential. Whether sharing heartfelt messages or professional updates, only the intended recipient—identified by their name, username, or email—can access your messages. Your privacy is always our top priority!",
                "With DropNRead, sending and receiving messages is as simple as logging in and entering a name, username, or email. Drop messages anytime, anywhere, and manage them with ease—edit or delete messages whenever needed.",
                "Enjoy seamless and secure messaging with DropNRead! Our platform ensures your messages remain private and are delivered to the right person—identified by name, username, or email—every time. Join now to experience a simple and engaging way to connect!"
            ],
            typeSpeed: 50,  // Speed of typing
            backSpeed: 30,  // Speed of deleting text
            backDelay: 1000,  // Delay before deleting text
            loop: true,  // Keep typing and deleting indefinitely
        };

        var typed = new Typed("#typed-text", options);  // Apply typing effect to the paragraph with id="typed-text"
    document.addEventListener("DOMContentLoaded", () => {
            let vantaEffect = VANTA.FOG({
                el: "body",
                mouseControls: true,
                touchControls: true,
                gyroControls: false,
                minHeight: 200.00,
                minWidth: 200.00
            });

            window.addEventListener("resize", () => {
                if (vantaEffect) vantaEffect.resize();
            });
        });

    </script>

</body>

</html>