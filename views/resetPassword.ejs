<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reset Password</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>
    <header class="header">
        <h1>Reset Your Drop<span style="color: #6200ea;">N</span>Read Password</h1>
    </header>
    <div class="form-container">
        <h3 style="color: #6200ea; font-size: 1.5rem;">Reset Password</h3>
        <form action="/reset-password" method="POST" class="chat-form">
            <input type="text" name="username" placeholder="Enter your username(Case Senstive)" required>
            <input type="email" name="email" placeholder="Enter your email address(Case Senstive)" required>
            <input type="password" name="password" placeholder="Enter Your Password" required>
            <button type="submit" class="button-style">Reset Password</button>
        </form>
        <div class="options-form">
            <p>New user? <a href="/register">Register here</a></p>
        </div>
    </div>
    <footer class="footer">
        <p>&copy; 2025 Message Drop | Designed with ❤️ by Satish Pandey.</p>
    </footer>
</body>

</html>