<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>register</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>
    <header class="header">
        <h1>Welcome to Drop<span style="color: #6200ea;">N</span>Read</h1>
    </header>
    <div class="form-container">
        <h3 style="color: #6200ea; font-size: 1.5rem;">Create a New Account</h3>
        <form action="/register" method="POST" class="chat-form">
            <input type="text" name="name" placeholder="Enter your full name" required>
            <input type="text" name="username" placeholder="Choose a username" required>
            <input type="email" name="email" placeholder="Enter Email" required>
            <input type="password" name="password" placeholder="Enter a password(Case Senstive)" required>
            <p class="password-requirements">Password must include 1 digit, 1 letter, 1 symbol, and be at least 5 characters long.</p>



            <!-- OTP Section -->
            <div class="otp-section">
                <button type="button" id="requestOtp" class="button-style">Request OTP</button>
                <div id="otpField" style="display:none;">
                    <input type="text" name="otp" placeholder="Enter the OTP" required>
                </div>
            </div>
            <p id="timer" class="password-requirements" style="color: #6200ea; font-size: 1rem; display:none;">Time
                remaining: <span id="countdown"></span></p>

            <button type="submit" class="button-style" id="submitButton" disabled>Create Account</button>

        </form>
        <div class="options-form">
            <p>Already have an account? <a href="/login">Login here</a></p>
        </div>
    </div>
    <footer class="footer">
        <p>&copy; 2025 Message Drop | Designed with ❤️ by Satish Pandey.</p>
    </footer>


    <script>
        const requestOtpButton = document.getElementById("requestOtp");
        const otpField = document.getElementById("otpField");
        const timerElement = document.getElementById("timer");
        const countdownElement = document.getElementById("countdown");

        let countdownInterval;
        function validatePassword(password) {
            const passwordRegex = /^(?=.*[a-zA-Z])(?=.*\d)(?=.*[@$!%*?&])[A-Za-z\d@$!%*?&]{5,}$/;
            return passwordRegex.test(password);
        }
        // Handle OTP request
        requestOtpButton.addEventListener("click", async () => {
            const emailField = document.querySelector('input[name="email"]');
            const email = emailField.value.trim();

            if (!email) {
                alert("Please enter your email address to request OTP.");
                return;
            }

            // We Check if all required fields are filled
            const nameField = document.querySelector('input[name="name"]');
            const usernameField = document.querySelector('input[name="username"]');
            const passwordField = document.querySelector('input[name="password"]');

            if (!nameField.value.trim() || !usernameField.value.trim() || !passwordField.value.trim()) {
                alert("Please fill in all the required fields before requesting OTP.");
                return;
            }

            // Validate the password
            if (!validatePassword(passwordField.value.trim())) {
                alert("Password must include 1 digit, 1 letter, 1 symbol, and be at least 5 characters long.");
                return;
            }

            try {
                const response = await fetch("/send-otp-reg", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify({ email })
                });

                const result = await response.json();
                if (response.ok) {
                    alert(result.msg || "OTP sent successfully. Please check your email.");
                    otpField.style.display = "block";

                    // Disable all inputs except OTP field
                    const formInputs = document.querySelectorAll("form.chat-form input");
                    formInputs.forEach(input => {
                        if (input.name !== "otp") {
                            input.readOnly = true;
                        }
                    });

                    // Disable the Request OTP button
                    requestOtpButton.disabled = true;
                    // Enable the submit button after OTP is sent
                    const submitButton = document.getElementById("submitButton");
                    submitButton.disabled = false;

                    // Start the timer
                    startTimer(300); // 5 minutes (300 seconds)
                } else {
                    alert(result.msg || "Failed to send OTP. Please try again.");
                }
            } catch (error) {
                console.error("Error requesting OTP:", error);
                alert("An error occurred. Please try again later.");
            }
        });

        // Timer Function
        function startTimer(duration) {
            let remainingTime = duration;

            // Show the timer
            timerElement.style.display = "block";

            countdownInterval = setInterval(() => {
                const minutes = Math.floor(remainingTime / 60);
                const seconds = remainingTime % 60;

                // Update the timer display
                countdownElement.textContent = `${minutes}:${seconds < 10 ? '0' : ''}${seconds}`;

                remainingTime--;

                if (remainingTime < 0) {
                    clearInterval(countdownInterval);

                    // Enable the Request OTP button after the timer ends
                    requestOtpButton.disabled = false;
                    timerElement.style.display = "none";

                    // Allow editing of form inputs again
                    const formInputs = document.querySelectorAll("form.chat-form input");
                    formInputs.forEach(input => {
                        input.readOnly = false;
                    });
                }
            }, 1000);
        }

    </script>
</body>

</html>