<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Notification</title>
  <link rel="stylesheet" href="/wrongs.css">
  <script>
    // Automatically close popup after 2 seconds and redirect
    window.onload = function () {
      setTimeout(() => {
        window.location.href = "<%= redirectUrl %>";
      }, 2000); // 2 seconds
    };
  </script>
</head>

<body>
  <div class="container">
    <div class="emoji">
      <div class="eye left"></div>
      <div class="eye right"></div>
      <div class="mouth"></div>
    </div>
    <div class="message">
      <%= message %>
    </div>
  </div>
</body>

</html>
