<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>New Chat</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>
    <header class="header">
        <h1>Drop<span style="color: #6200ea;">N</span>Read</h1>
    </header>
    <main class="form-container">
        <h3 style="color: #6200ea; font-size: 1.5rem;">Write a New Message</h3>
        <form action="/chats" method="POST" class="chat-form">
            <input type="text" placeholder="Who are you?" name="from" value="<%= userName.toUpperCase() %>" required
                readonly>
            <label for="dropdownValue" class="dropdownValueLabel">Send Message By:</label>
            <select name="dropdownValue" id="dropdownValue" required>
                <option value="Name">Name</option>
                <option value="Email">Email</option>
                <option value="Username">Username</option>
            </select>

            <p class="password-requirements">For full privacy, choose Username or Email. Messages sent using these will
                only be
                visible to the matching recipient, as both Username and Email are unique on this platform. Note:
                Name-based messages
                might match multiple users.</p>

            <input type="text" placeholder="Add Receiver" name="to" required>
            <textarea name="message" placeholder="Write your message here..." rows="5" maxlength="1000"
                required></textarea>
            <p class="password-requirements">
                Maximum character limit: 1,000.
            </p>
            <button type="submit" class="button-style">Create Chat</button>
        </form>
    </main>
    <footer class="footer">
        <p>&copy; 2025 Message Drop | Designed with ❤️ by Satish Pandey.</p>
    </footer>
</body>

</html>