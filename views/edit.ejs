<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit your Chat</title>
    <link rel="stylesheet" href="/style.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r134/three.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/vanta@latest/dist/vanta.fog.min.js"></script>
</head>

<body>
    <header class="header">
        <h1>Drop<span style="color: #FF4500;">N</span>Read</h1>
        <h1>Edit Chat for User Id: <%= chat._id.toString().slice(20) %></h1>

    </header>
    <div class="form-container">
        <p style="color: #FF4500; font-size: 1.5rem; font-weight: bold;">This Edit is Page <b>
                <%= chat.from.toUpperCase() %>
            </b> to <b>
                <%= chat.to.toUpperCase() %>
            </b>
        </p>
        <form class="chat-form" action="/chats/<%= chat._id %>?_method=PUT" method="POST">
            <textarea name="newMsg" maxlength="1000" required><%= chat.message %></textarea>
            <p class="password-requirements">
                Maximum character limit: 1,000.
            </p>            
            <button class="button-style">Save Changes</button>
        </form>
    </div>
    <footer class="footer">
        <p>&copy; 2025 Message Drop | Designed with ❤️ by Satish Pandey.</p>
    </footer>
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            VANTA.FOG({
                el: "body",
                mouseControls: true,
                touchControls: true,
                gyroControls: false,
                minHeight: 200.00,
                minWidth: 200.00
            })
        });
    </script>
</body>

</html>